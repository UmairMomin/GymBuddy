# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase Project Reference ID (for CLI migrations linking)
SUPABASE_PROJECT_ID=your-project-id

# Web Push (generate with: npx web-push generate-vapid-keys). The private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services in the VAPID claim. Use a mailto: or https: URL you are happy to share.
VAPID_SUBJECT=mailto:noreply@example.com
